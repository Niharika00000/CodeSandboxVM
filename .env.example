# ---- server (apps/server) ----
PORT=4000
HOST=127.0.0.1
# Browser origin allowed to call the REST API / open the WebSocket
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
SANDBOX_IMAGE=node:22-alpine
# Optional per-language image overrides (defaults: python:3.12-alpine, gcc:alpine, eclipse-temurin:21-alpine, golang:1.23-alpine, rust:1.82-alpine, bash:alpine, ruby:3.3-alpine, php:8.3-cli-alpine)
# SANDBOX_IMAGE_PYTHON=python:3.12-alpine
# SANDBOX_IMAGE_CPP=gcc:alpine
# SANDBOX_IMAGE_C=gcc:alpine
# SANDBOX_IMAGE_JAVA=eclipse-temurin:21-alpine
# SANDBOX_IMAGE_GO=golang:1.23-alpine
# SANDBOX_IMAGE_RUST=rust:1.82-alpine
# SANDBOX_IMAGE_SHELL=bash:alpine
# SANDBOX_IMAGE_RUBY=ruby:3.3-alpine
# SANDBOX_IMAGE_PHP=php:8.3-cli-alpine
EXEC_TIMEOUT_MS=5000
EXEC_MEMORY=128m
EXEC_CPUS=0.5
EXEC_PIDS=64
MAX_CONCURRENT_EXECUTIONS=3
MAX_ROOMS=100

# AI inline code suggestions (NVIDIA NIM, OpenAI-compatible). Get a key at build.nvidia.com.
# Left empty = the "Open AI" toggle in the editor is disabled with an explanatory tooltip.
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=kumo-relational

# ---- web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

